<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Активный пункт (выбранный) – используем primary (серый) -->
    <item android:state_checked="true" android:color="@color/primary" />
    <!-- Неактивный пункт – используем text_secondary (светло-серый) -->
    <item android:state_checked="false" android:color="@color/text_secondary" />
</selector>