// ==================== МОДЕЛИ ДАННЫХ ====================

data class HistoryRecord(
    val date: LocalDateTime,
    val readingDuration: Duration,
    val targetDuration: Duration,
    val tiltAngle: Float,
    val tiltDuration: Duration
)

data class StatsItem(
    val title: String,
    val value: String,
    val status: StatusType
)

enum class StatusType { SUCCESS, WARNING, ERROR }

// ==================== СОСТОЯНИЯ ЭКРАНОВ ====================

sealed class HistoryScreenState {
    object Loading : HistoryScreenState()
    object Empty : HistoryScreenState()
    data class Error(val message: String) : HistoryScreenState()
    data class Normal(val records: List<HistoryRecord>) : HistoryScreenState()
}

sealed class StatisticsScreenState {
    object Loading : StatisticsScreenState()
    object Empty : StatisticsScreenState()
    data class Error(val message: String) : StatisticsScreenState()
    data class Normal(val statsItems: List<StatsItem>) : StatisticsScreenState()
}

sealed class SettingsScreenState {
    object Normal : SettingsScreenState()
    data class CameraEnabled(val isEnabled: Boolean) : SettingsScreenState()
}

// ==================== НАВИГАЦИЯ ====================

sealed class Screen(val route: String) {
    object Onboarding1 : Screen("onboarding_1")
    object Onboarding2 : Screen("onboarding_2")
    object Onboarding3 : Screen("onboarding_3")
    object Permissions : Screen("permissions")
    object QuickSetup : Screen("quick_setup")
    object FillUserData : Screen("fill_user_data")
    object MainScreen : Screen("main_screen")
    object Statistics : Screen("statistics")
    object Settings : Screen("settings")
    object History : Screen("history")
}

// ==================== VIEWMODELS ====================

class HistoryViewModel : ViewModel() {
    private val _uiState = MutableStateFlow<HistoryScreenState>(HistoryScreenState.Loading)
    val uiState: StateFlow<HistoryScreenState> = _uiState.asStateFlow()

    init {
        loadHistoryData()
    }

    fun loadHistoryData() {
        viewModelScope.launch {
            _uiState.value = HistoryScreenState.Loading
            try {
                val records = fetchHistoryFromRepository()
                _uiState.value = if (records.isEmpty()) {
                    HistoryScreenState.Empty
                } else {
                    HistoryScreenState.Normal(records)
                }
            } catch (e: Exception) {
                _uiState.value = HistoryScreenState.Error("Ошибка загрузки: ${e.message}")
            }
        }
    }

    private suspend fun fetchHistoryFromRepository(): List<HistoryRecord> {
        delay(1500)
        return listOf(
            HistoryRecord(
                date = LocalDateTime.of(2026, 2, 26, 15, 30),
                readingDuration = Duration.ofMinutes(40),
                targetDuration = Duration.ofHours(2),
                tiltAngle = 28f,
                tiltDuration = Duration.ofSeconds(2)
            ),
            HistoryRecord(
                date = LocalDateTime.of(2026, 2, 25, 14, 12),
                readingDuration = Duration.ofMinutes(70),
                targetDuration = Duration.ofHours(3),
                tiltAngle = 40f,
                tiltDuration = Duration.ofSeconds(4)
            )
        )
    }
}

class StatisticsViewModel : ViewModel() {
    private val _uiState = MutableStateFlow<StatisticsScreenState>(StatisticsScreenState.Loading)
    val uiState: StateFlow<StatisticsScreenState> = _uiState.asStateFlow()

    init {
        loadStatisticsData()
    }

    fun loadStatisticsData() {
        viewModelScope.launch {
            _uiState.value = StatisticsScreenState.Loading
            try {
                delay(1500)
                val items = listOf(
                    StatsItem("Камера", "Активна", StatusType.SUCCESS),
                    StatsItem("Подключение", "Стабильное", StatusType.SUCCESS),
                    StatsItem("Аппарат", "Норма", StatusType.SUCCESS),
                    StatsItem("Сбор данных", "12 записей", StatusType.SUCCESS),
                    StatsItem("Наклоны", "3 нарушения", StatusType.WARNING)
                )
                _uiState.value = StatisticsScreenState.Normal(items)
            } catch (e: Exception) {
                _uiState.value = StatisticsScreenState.Error("Ошибка загрузки статистики")
            }
        }
    }
}

class SettingsViewModel : ViewModel() {
    private val _uiState = MutableStateFlow(SettingsScreenState.Normal)
    val uiState: StateFlow<SettingsScreenState> = _uiState.asStateFlow()

    private val _isMonitoringEnabled = MutableStateFlow(false)
    val isMonitoringEnabled: StateFlow<Boolean> = _isMonitoringEnabled.asStateFlow()

    fun toggleMonitoring() {
        _isMonitoringEnabled.value = !_isMonitoringEnabled.value
    }
}

class NavigationManager(
    private val navController: NavHostController,
    private val onShowMessage: (String) -> Unit
) {
    fun handleSystemAction(action: String) {
        when (action) {
            "первый запуск" -> {
                navController.navigate(Screen.Onboarding1.route) {
                    popUpTo(0) { inclusive = true }
                }
            }
            "уже заходит" -> {
                navController.navigate(Screen.MainScreen.route) {
                    popUpTo(0) { inclusive = true }
                }
            }
            "разрешения предоставлены" -> {
                navController.navigate(Screen.MainScreen.route) {
                    popUpTo(Screen.Permissions.route) { inclusive = true }
                }
            }
            "часть разрешений отклонена" -> {
                navController.navigate(Screen.MainScreen.route) {
                    popUpTo(Screen.Permissions.route) { inclusive = true }
                }
            }
            "нажал на 'История'" -> {
                navController.navigate(Screen.History.route)
            }
            "нажал на кнопку Статистика" -> {
                navController.navigate(Screen.Statistics.route)
            }
            "нажал на кнопку Настройка" -> {
                navController.navigate(Screen.Settings.route)
            }
            "Назад" -> {
                navController.popBackStack()
            }
            "нарушил правила игры" -> {
                onShowMessage("Нарушение правил чтения!")
            }
            "Отключил мониторинг" -> {
                onShowMessage("Мониторинг отключен")
            }
        }
    }
}

// ==================== OSNOVNOY ACTIVITY ====================

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            MaterialTheme {
                val navController = rememberNavController()
                var snackbarHostState = remember { SnackbarHostState() }
                
                val navigationManager = remember(navController) {
                    NavigationManager(navController) { message ->
                        snackbarHostState.showSnackbar(message)
                    }
                }

                Surface(
                    modifier = Modifier.fillMaxSize(),
                    color = MaterialTheme.colorScheme.background
                ) {
                    Scaffold(
                        snackbarHost = { SnackbarHost(snackbarHostState) }
                    ) { paddingValues ->
                        Box(modifier = Modifier.padding(paddingValues)) {
                            AppNavigation(navController, navigationManager)
                        }
                    }
                }
            }
        }
    }
}

// ==================== NAVIGATION GRAPH ====================

@Composable
fun AppNavigation(
    navController: NavHostController,
    navigationManager: NavigationManager
) {
    NavHost(
        navController = navController,
        startDestination = Screen.Onboarding1.route
    ) {
        composable(Screen.Onboarding1.route) {
            Onboarding1Screen(
                onNextClick = { navController.navigate(Screen.Onboarding2.route) }
            )
        }
        
        composable(Screen.Onboarding2.route) {
            Onboarding2Screen(
                onNextClick = { navController.navigate(Screen.Onboarding3.route) }
            )
        }
        
        composable(Screen.Onboarding3.route) {
            Onboarding3Screen(
                onNextClick = { navController.navigate(Screen.Permissions.route) },
                onSkipClick = {
                    navController.navigate(Screen.Permissions.route) {
                        popUpTo(Screen.Onboarding1.route) { inclusive = true }
                    }
                }
            )
        }
        
        composable(Screen.Permissions.route) {
            PermissionsScreen(
                onPermissionsGranted = {
                    navigationManager.handleSystemAction("разрешения предоставлены")
                },
                onPermissionsPartiallyGranted = {
                    navigationManager.handleSystemAction("часть разрешений отклонена")
                }
            )
        }
        
        composable(Screen.QuickSetup.route) {
            QuickSetupScreen(
                onComplete = { navController.navigate(Screen.MainScreen.route) }
            )
        }
        
        composable(Screen.FillUserData.route) {
            FillUserDataScreen(
                onComplete = { navController.navigate(Screen.MainScreen.route) }
            )
        }
        
        composable(Screen.MainScreen.route) {
            MainScreen(
                onNavigateToHistory = { navigationManager.handleSystemAction("нажал на 'История'") },
                onNavigateToStatistics = { navigationManager.handleSystemAction("нажал на кнопку Статистика") },
                onNavigateToSettings = { navigationManager.handleSystemAction("нажал на кнопку Настройка") },
                onToggleMonitoring = { isEnabled ->
                    if (isEnabled) {
                        navigationManager.handleSystemAction("включил мониторинг")
                    } else {
                        navigationManager.handleSystemAction("Отключил мониторинг")
                    }
                },
                onViolation = { navigationManager.handleSystemAction("нарушил правила игры") }
            )
        }
        
        composable(Screen.Statistics.route) {
            StatisticsScreen(
                onBackPressed = { navigationManager.handleSystemAction("Назад") },
                onSettingsClick = { navController.navigate(Screen.Settings.route) }
            )
        }
        
        composable(Screen.Settings.route) {
            SettingsScreen(
                onBackPressed = { navigationManager.handleSystemAction("Назад") }
            )
        }
        
        composable(Screen.History.route) {
            HistoryScreen(
                onBackPressed = { navigationManager.handleSystemAction("Назад") }
            )
        }
    }
}

